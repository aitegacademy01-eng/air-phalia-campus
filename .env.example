# Configure secrets in Vercel → Project → Settings → Environment Variables. Never commit live credentials.

# Storage (one is required for enquiries to be accepted; Postgres is preferred and takes priority)
# Postgres connection string, e.g. Neon from the Vercel Marketplace (POSTGRES_URL also works)
DATABASE_URL=
# Set automatically when a private Vercel Blob store is connected to the project
BLOB_READ_WRITE_TOKEN=

# Staff admissions desk (/admin)
ADMIN_TOKEN=

# Optional: canonical URL when a custom domain is attached
NEXT_PUBLIC_SITE_URL=

# Optional: AI answers in the school guide (not enabled until configured and tested)
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional: WhatsApp Cloud API webhook (not live until configured and tested)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=
META_GRAPH_VERSION=
SCHOOL_WHATSAPP_NUMBER=
